{% comment %}
  News list, styled like the publication rows: text on the left, date in a right-aligned column.
  include.limit: show only page.announcements.limit items (homepage).
{% endcomment %}
<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = site.news | size %}
    {% endif %}
    <ol class="news-list">
      {% for item in news limit: news_limit %}
        <li class="news-item">
          <div class="news-text">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
          <time class="news-date" datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
