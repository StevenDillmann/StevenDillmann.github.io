{% comment %}
  Uniform social icon row for the homepage: every icon is a same-size square in the text color.
  Brand glyphs are Simple Icons SVGs (_includes/icons/), plus the LinkedIn "in" and the Academicons Google Scholar mark. Links come from _data/socials.yml.
{% endcomment %}
{% assign s = site.data.socials %}
{% if s.email %}<a class="soc-mail" href="mailto:{{ s.email | encode_email }}" title="Email" aria-label="Email">{% include icons/mail.svg %}</a>{% endif %}
{% if s.discord_id %}<a class="soc-discord" href="https://discord.com/users/{{ s.discord_id }}" title="Discord{% if s.discord_username %}: {{ s.discord_username }}{% endif %}" aria-label="Discord" target="_blank" rel="noopener noreferrer">{% include icons/discord.svg %}</a>{% endif %}
{% if s.x_username %}<a class="soc-x" href="https://x.com/{{ s.x_username }}" title="X" aria-label="X" target="_blank" rel="noopener noreferrer">{% include icons/x.svg %}</a>{% endif %}
{% if s.linkedin_username %}<a class="soc-linkedin" href="https://www.linkedin.com/in/{{ s.linkedin_username }}" title="LinkedIn" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>{% endif %}
{% if s.github_username %}<a class="soc-github" href="https://github.com/{{ s.github_username }}" title="GitHub" aria-label="GitHub" target="_blank" rel="noopener noreferrer">{% include icons/github.svg %}</a>{% endif %}
{% if s.scholar_userid %}<a class="soc-scholar" href="https://scholar.google.com/citations?user={{ s.scholar_userid }}" title="Google Scholar" aria-label="Google Scholar" target="_blank" rel="noopener noreferrer"><i class="ai ai-google-scholar" aria-hidden="true"></i></a>{% endif %}
{% if s.orcid_id %}<a class="soc-orcid" href="https://orcid.org/{{ s.orcid_id }}" title="ORCID" aria-label="ORCID" target="_blank" rel="noopener noreferrer">{% include icons/orcid.svg %}</a>{% endif %}
{% if s.letterboxd_username %}<a class="soc-letterboxd" href="https://letterboxd.com/{{ s.letterboxd_username }}" title="Letterboxd" aria-label="Letterboxd" target="_blank" rel="noopener noreferrer">{% include icons/letterboxd.svg %}</a>{% endif %}
